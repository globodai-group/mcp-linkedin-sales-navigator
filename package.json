{
  "name": "globodai-mcp-linkedin-sales-navigator",
  "version": "0.2.0",
  "description": "MCP server for LinkedIn Sales Navigator - Browser automation via Clawdbot/Playwright",
  "author": "GlobodAI Group <dev@globodai.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-linkedin-sales-navigator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.63.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "linkedin",
    "sales-navigator",
    "browser-automation",
    "playwright",
    "clawdbot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/globodai-group/mcp-linkedin-sales-navigator.git"
  }
}
